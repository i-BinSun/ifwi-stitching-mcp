# Copy to .env and fill in your own values. .env is gitignored - keep tokens there only.

FIV_BASE_URL=https://fiv-ifwi.intel.com
FIV_TOKEN=<fiv-access-token>
ARTIFACTORY_TOKEN=<artifactory-access-token>

# MCP serving transport (independent of stitch job execution below).
# Default: local stdio. Server mode exposes authenticated Streamable HTTP at /mcp.
# IFWI_MCP_SERVE_MODE=server
# IFWI_MCP_SERVE_HOST=127.0.0.1
# IFWI_MCP_SERVE_PORT=8000
# IFWI_MCP_SERVE_TOKEN=<strong-random-client-token>
# Server mode requires remote execution with an endpoint; each stitch request supplies fiv_project_id.

# Execution switch. Omit for local execution (the default).
# IFWI_MCP_EXEC_MODE=remote
# IFWI_MCP_EXEC_ENDPOINT=http://infra-api-fiv.bios-dev-sh-cloud.intel.com/v1/fivportal/job
# IFWI_MCP_ARTIFACTORY_REPO=https://af01p-sc.devtools.intel.com/artifactory/DEG-IFWI-LOCAL/FIV_Portal/RemoteStitch
# IFWI_MCP_EXEC_IMAGE=amr-registry.caas.intel.com/fia-cloud/fiv_auto_service:v3.2.9.6
# IFWI_MCP_EXEC_REPO=https://github.com/i-BinSun/ifwi-stitching-mcp.git
# IFWI_MCP_EXEC_REF=main
# IFWI_MCP_EXEC_TIMEOUT=3600
# IFWI_MCP_EXEC_POLL_INTERVAL=5
# IFWI_MCP_DELIVERABLES_ARCHIVE=true

# IFWI_MCP_CACHE_DIR=
