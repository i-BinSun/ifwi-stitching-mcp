# Copy to .env and fill in your own values. .env is gitignored - keep tokens there only.

FIV_BASE_URL=https://fiv-ifwi.intel.com
FIV_TOKEN=<fiv-access-token>
ARTIFACTORY_TOKEN=<artifactory-access-token>

# MCP serving transport (independent of stitch job execution below).
# Default: local stdio. Server mode exposes authenticated Streamable HTTP at /mcp.
# IFWI_MCP_SERVER_MODE=server
# IFWI_MCP_SERVER_HOST=127.0.0.1
# IFWI_MCP_SERVER_PORT=8000
# IFWI_MCP_SERVER_TOKEN=<strong-random-client-token>
# Server mode supports local execution with an Artifactory repo, or remote execution with an endpoint.

# Execution switch. Omit for local execution (the default).
# IFWI_MCP_EXEC_MODE=remote
# IFWI_MCP_EXEC_ENDPOINT=http://infra-api-fiv-linux.bios-dev-sh-cloud.intel.com/v1/fivportal/job
# IFWI_MCP_ARTIFACTORY_REPO=https://af01p-sc.devtools.intel.com/artifactory/DEG-IFWI-LOCAL/FIV_Portal/RemoteStitch
# IFWI_MCP_EXEC_IMAGE=amr-registry.caas.intel.com/fia-cloud/fiv-ubuntu24.04-python3.13:v1.1.1
# IFWI_MCP_EXEC_REPO=https://github.com/i-BinSun/ifwi-stitching-mcp.git
# IFWI_MCP_EXEC_REF=main
# IFWI_MCP_EXEC_TIMEOUT=3600
# IFWI_MCP_EXEC_POLL_INTERVAL=5
# Server mode only: address the stitch pods call back (callback route /internal/jobs/*/result).
# IFWI_MCP_REPORT_BASE_URL=https://ifwi-mcp.example.intel.com
# IFWI_MCP_EXEC_PENDING_TIMEOUT=900
# IFWI_MCP_EXEC_FINALIZE_GRACE=120
# IFWI_MCP_MAX_ACTIVE_JOBS=64
# Remote jobs beyond this many live pods wait in state "queued" (0 = no limit).
# IFWI_MCP_MAX_RUNNING_PODS=5
# IFWI_MCP_JOB_RETENTION_HOURS=168
# IFWI_MCP_JOBS_DB=
# IFWI_MCP_RUN_RETENTION_HOURS=0
# IFWI_MCP_DELIVERABLES_ARCHIVE=true

# IFWI_MCP_CACHE_DIR=
