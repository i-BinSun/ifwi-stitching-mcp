# Copy to deploy.env on the Docker host and replace every placeholder.
# Never commit deploy.env or real credentials.
IFWI_MCP_SERVER_TOKEN=replace-with-a-strong-random-token
IFWI_MCP_EXEC_ENDPOINT=http://infra-api-fiv-linux.bios-dev-sh-cloud.intel.com/v1/fivportal/job
IFWI_MCP_ARTIFACTORY_REPO=https://af01p-sc.devtools.intel.com/artifactory/DEG-IFWI-LOCAL/FIV_Portal/RemoteStitch
# Server address the stitch pods can reach, e.g. the HTTPS reverse proxy in front of this
# container; the proxy must forward /internal/jobs/*/result. Leave unset to rely on
# status queries and result.json only (no callback).
IFWI_MCP_REPORT_BASE_URL=https://replace-with-the-public-server-address
FIV_TOKEN=replace-with-fiv-token
ARTIFACTORY_TOKEN=replace-with-artifactory-token
# Set these if your installation uses non-default values:
# FIV_BASE_URL=https://fiv-ifwi.intel.com
# IFWI_MCP_EXEC_IMAGE=amr-registry.caas.intel.com/fia-cloud/fiv-ubuntu24.04-python3.13:v1.1.1
# IFWI_MCP_EXEC_REPO=https://github.com/i-BinSun/ifwi-stitching-mcp.git
# IFWI_MCP_EXEC_REF=main
# IFWI_MCP_EXEC_PENDING_TIMEOUT=900
# IFWI_MCP_MAX_ACTIVE_JOBS=64
# IFWI_MCP_JOB_RETENTION_HOURS=168
# Job records live in /data/cache/jobs.db on the ifwi-mcp-data volume; to move them:
# IFWI_MCP_JOBS_DB=/data/jobs/jobs.db
