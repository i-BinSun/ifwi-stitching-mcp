# Copy to deploy.env on the Docker host and replace every placeholder.
# Never commit deploy.env or real credentials.
IFWI_MCP_SERVE_TOKEN=replace-with-a-strong-random-token
IFWI_MCP_EXEC_ENDPOINT=https://runner.example.com
FIV_TOKEN=replace-with-fiv-token
ARTIFACTORY_TOKEN=replace-with-artifactory-token
# Set these if your installation uses non-default endpoints or authenticated runner:
# FIV_BASE_URL=https://fiv-ifwi.intel.com
# IFWI_MCP_EXEC_TOKEN=replace-with-runner-token
# IFWI_MCP_ARTIFACTORY_REPO=https://artifactory.example.com/artifactory/repository/path